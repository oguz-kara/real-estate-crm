# Copy these into Dokploy -> (compose service) -> Environment. Never commit real values.

TAG=v2.44.0
SERVER_URL=https://crm.example.com

# openssl rand -hex 24   (letters and digits only)
PG_DATABASE_PASSWORD=
# openssl rand -base64 32   (back this up: losing it makes stored secrets unreadable)
ENCRYPTION_KEY=

STORAGE_TYPE=local
LOGIC_FUNCTION_TYPE=LOCAL

# One line, single quotes. Put a NEW DeepSeek key in apiKey.
AI_PROVIDERS='{"deepseek":{"npm":"@ai-sdk/openai-compatible","name":"deepseek","label":"DeepSeek","baseUrl":"https://api.deepseek.com","apiKey":"REPLACE_ME","models":[{"name":"deepseek-flash","label":"DeepSeek Flash","inputCostPerMillionTokens":0.3,"outputCostPerMillionTokens":1.2,"contextWindowTokens":1000000,"maxOutputTokens":384000},{"name":"deepseek-v4-pro","label":"DeepSeek V4 Pro","inputCostPerMillionTokens":1.32,"outputCostPerMillionTokens":3.96,"contextWindowTokens":1000000,"maxOutputTokens":384000}]}}'

# Optional, needed for invitations and password reset e-mails. To enable,
# also add these variable names to the x-twenty-env block in docker-compose.yml.
# EMAIL_DRIVER=SMTP
# EMAIL_FROM_ADDRESS=crm@example.com
# EMAIL_FROM_NAME=Emlak CRM
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
